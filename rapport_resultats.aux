\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Rapport d'audit symbolique~: aretes survivantes par porte T-KAN, formule extraite par regression ($c\cdot f(ax+b)+d$), importance $|\varphi _{ij}|_1$ et coefficient $R^2$. Les aretes marquees \@FB@og  non-symbolifiable~(numerique)\@FB@fg  \relax {} ont $R^2 < 0.80$~: comportements hybrides Gaussiens+Fourier sans forme fermee simple, signalees explicitement conformement a la politique de transparence COBAC \cite  {cobac2018} (section 2.5.5 du memoire).}}{10}{figure.caption.21}\protected@file@percent }
\newlabel{fig:symbolic}{{12}{10}{Rapport d'audit symbolique~: aretes survivantes par porte T-KAN, formule extraite par regression ($c\cdot f(ax+b)+d$), importance $|\phiij |_1$ et coefficient $R^2$. Les aretes marquees \og non-symbolifiable~(numerique)\fg {} ont $R^2 < 0.80$~: comportements hybrides Gaussiens+Fourier sans forme fermee simple, signalees explicitement conformement a la politique de transparence COBAC \cite {cobac2018} (section 2.5.5 du memoire)}{figure.caption.21}{}}
