\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Tableau de bord complet de l'entrainement \textsc  {mkan}{} sur 40~epoques~: perte totale (eq.~\ref {eq:loss}), composante predictive $\ell _{\text  {pred}}$, norme L1, entropie $S$, MCC et AUC-ROC de validation. Deux perturbations transitoires aux epoques~20 et~29 marquent les evenements de \emph  {Grid Extension} declenches par la derive de \texttt  {var\_agent\_split} (JS$\,{=}\,0.051$)~; le MCC se retablit en 2--3~epoques dans les deux cas. ($\star $) indique le \emph  {checkpoint} selectionne (epoque~7, MCC-val$\,{=}\,0.9544$).}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:training}{{1}{3}{Tableau de bord complet de l'entrainement \MKAN {} sur 40~epoques~: perte totale (eq.~\ref {eq:loss}), composante predictive $\ell _{\text {pred}}$, norme L1, entropie $S$, MCC et AUC-ROC de validation. Deux perturbations transitoires aux epoques~20 et~29 marquent les evenements de \emph {Grid Extension} declenches par la derive de \texttt {var\_agent\_split} (JS$\,{=}\,0.051$)~; le MCC se retablit en 2--3~epoques dans les deux cas. ($\star $) indique le \emph {checkpoint} selectionne (epoque~7, MCC-val$\,{=}\,0.9544$)}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Decomposition de la perte (echelle logarithmique)~: $\ell _{\text  {total}}$ (courbe noire, $\approx \!0.28$), $\ell _{\text  {pred}}$ BCE ponderee (courbe bleue, $\approx \!0.064$) et terme de regularisation (courbe rouge, $\approx \!0.21$). La regularisation represente environ $75\,\%$ de la perte totale~: priorite a la sparsification sur la performance discriminative brute. Les pics des epoques~20 et~29 correspondent aux evenements de \emph  {Grid Extension} et se resorbent en 2--3~epoques.}}{3}{figure.caption.7}\protected@file@percent }
\newlabel{fig:loss}{{2}{3}{Decomposition de la perte (echelle logarithmique)~: $\ell _{\text {total}}$ (courbe noire, $\approx \!0.28$), $\ell _{\text {pred}}$ BCE ponderee (courbe bleue, $\approx \!0.064$) et terme de regularisation (courbe rouge, $\approx \!0.21$). La regularisation represente environ $75\,\%$ de la perte totale~: priorite a la sparsification sur la performance discriminative brute. Les pics des epoques~20 et~29 correspondent aux evenements de \emph {Grid Extension} et se resorbent en 2--3~epoques}{figure.caption.7}{}}
